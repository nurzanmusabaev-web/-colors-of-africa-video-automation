# --- LLM (сценарий, заголовки, описания, скоринг) ---
ANTHROPIC_API_KEY=sk-ant-...
COA_LLM_MODEL=claude-opus-5

# --- Озвучка ---
# Провайдер: elevenlabs | openai | none (none = тишина, для сухого прогона)
COA_TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_API_KEY=
COA_TTS_VOICE=onyx

# --- Футаж ---
# Локальный архив клипов (сканируется рекурсивно)
COA_FOOTAGE_DIR=./footage
# Стоковый добор, если в архиве не нашлось сцены
PEXELS_API_KEY=

# --- YouTube ---
# OAuth desktop-клиент из Google Cloud Console
COA_YT_CLIENT_SECRET=./client_secret.json
COA_YT_TOKEN=./token.json
COA_YT_CHANNEL_ID=UC_KbPxbWw3r6Nqjz8-lUAIg

# --- Пороги гейтов ---
# Минимальный балл упаковки (0-100), ниже которого проект не идёт дальше
COA_MIN_PACKAGING_SCORE=70
